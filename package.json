{
  "name": "flight-radar",
  "version": "1.1.4",
  "private": true,
  "description": "Personal flight tracker using free community ADS-B data",
  "author": "matty-doop",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.mattydoop.flightradar",
    "productName": "Flight Radar",
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/adhoc-sign.js",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Flight-Radar-portable.exe"
    },
    "nsis": {
      "artifactName": "Flight-Radar-Setup.exe",
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.travel"
    },
    "dmg": {
      "artifactName": "Flight-Radar-${arch}.dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "matty-doop",
        "repo": "flight-radar",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
